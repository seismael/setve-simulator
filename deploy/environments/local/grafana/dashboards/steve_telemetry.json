      "id": 2,
      "title": "Total Completed I/O Operations",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "steve_cluster_ops_total",
          "legendFormat": "Total Ops",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        }
