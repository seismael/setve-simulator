      "id": 1,
      "title": "Cluster Aggregate Throughput (Gbps)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(steve_cluster_bytes_total[5s]) * 8 / 1e9",
          "legendFormat": "Bandwidth (Gbps)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Gbps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
